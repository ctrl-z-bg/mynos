CWD        = $(shell pwd)
MYNOS_CORE_ROOT    = $(CWD:%/$(RELPATH)=%)

CC = gcc
# -mgeneral-regs-only: the kernel never touches the FPU, whose registers
# hold the running thread's state (softtaskswitch.c, mynos-t6p)
CFLAGS = -DMYNOS -nostdinc -Wall -I. -fno-stack-protector -fno-pie -g -mgeneral-regs-only
LD = ld
MAKE	= make
AS = nasm
ASFLAGS = -f elf

# each object's header dependencies, written as it compiles (OBJ.d) and
# read by the Makefiles: a changed header (tss.h) recompiles what includes
# it. Without them, objects of an old layout of a struct were linked with
# new ones (mynos-y87: tss_t grew, and the kernel no longer booted)
CFLAGS += -MMD -MP

# the architecture (doc/decisions/arch.md): its code is in kernel/arch/$(ARCH);
# every part of the kernel sees the kernel's own headers ("mem/mem.h") and
# the architecture's ("gdt.h") by name
ARCH ?= i386
CFLAGS += -I$(MYNOS_CORE_ROOT)/kernel -I$(MYNOS_CORE_ROOT)/kernel/arch/$(ARCH)
# the architecture's own flags and the kernel's link (arch/ARCH/arch.mk)
include $(MYNOS_CORE_ROOT)/kernel/arch/$(ARCH)/arch.mk
