# llmd's test configuration (tests/net/net_test.ml): three profiles on the
# fake provider of tools/net-peer.py (port 47090 on the host)
export LLM_DEFAULT=claude
TEST_KEY="test-key"

LLM_CLAUDE_API=anthropic
LLM_CLAUDE_MODEL=fake-claude          # a comment
LLM_CLAUDE_KEY=${TEST_KEY}
LLM_CLAUDE_URL=http://10.0.2.2:47090/v1/
LLM_CLAUDE_FALLBACKS=default

LLM_LOCAL_API=openai
LLM_LOCAL_MODEL='fake-local'
LLM_LOCAL_URL=http://10.0.2.2:47090/v1

LLM_BAD_KEY_API=anthropic
LLM_BAD_KEY_MODEL=fake-claude
LLM_BAD_KEY_KEY=wrong
LLM_BAD_KEY_URL=http://10.0.2.2:47090/v1
