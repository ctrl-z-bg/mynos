# The package zxspectrum (tools/pkg-build.sh): a ZX Spectrum 48K, MyNOS's
# own emulator (doc/decisions/retro-emulators.md), and its service emu/1
NAME=zxspectrum
VERSION=1.0
DESCRIPTION='A ZX Spectrum 48K, in a window and as a service (emu/1: zx<pid>): tapes loaded at once, snapshots, the beeper; type zxspectrum [file.tap]'
LICENSE='MIT; the ROM: Amstrad'
LIBRARIES=threads
SRC=packages/zxspectrum
# in the order ocamldep -sort gives; packages/retro's shared with other machines
SOURCES='../retro/z80.mli ../retro/z80.ml ../retro/z80_disasm.mli ../retro/z80_disasm.ml ../retro/png.ml ../retro/emu_proto.mli ../retro/emu_proto.ml ../retro/emu_service.mli ../retro/emu_service.ml keyboard.mli keyboard.ml ula.mli ula.ml beeper.mli beeper.ml tape.mli tape.ml snapshot.mli snapshot.ml spectrum.mli spectrum.ml zxspectrum_main.ml'
EXTRA='packages/zxspectrum/48.rom packages/zxspectrum/ROM-LICENSE packages/zxspectrum/LICENSE'
DOC=packages/zxspectrum/README.md
