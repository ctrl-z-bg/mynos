VERSION=1.1
DESCRIPTION='Commands for text and files: grep, wc, head, tail, sort, uniq, find, du, df, hexdump, tree, clip'
LICENSE=GPL-2.0-or-later
LIBRARIES=str
SRC=packages/utils
SOURCES='util.ml grep.ml wc.ml head.ml tail.ml sort.ml uniq.ml find.ml du.ml df.ml hexdump.ml tree.ml clip.ml utils.ml'
COMMANDS='grep wc head tail sort uniq find du df hexdump tree clip'
DOC=packages/utils/README.md
