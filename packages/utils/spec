SOURCES='util.ml grep.ml wc.ml head.ml tail.ml sort.ml uniq.ml find.ml du.ml hexdump.ml tree.ml utils.ml'
COMMANDS='grep wc head tail sort uniq find du hexdump tree'
DOC=packages/utils/README.md
