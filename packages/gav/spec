NAME=gav
VERSION=1.1
DESCRIPTION='GAV, GPL Arcade Volleyball, ported to OCaml: 1 or 2 players a side, at the keyboard or the computer'
LICENSE=GPL-2.0-or-later
LIBRARIES=threads
SRC=packages/gav
SOURCES='../view/image.ml ../view/inflate.ml ../view/png.ml gav.ml'
RUN=gav
DOC=packages/gav/README.md
EXTRA='third_party/gav/background.png third_party/gav/ball.png third_party/gav/plml.png third_party/gav/plmr.png third_party/gav/font.png third_party/gav/LICENSE third_party/gav/MYNOS.md'
