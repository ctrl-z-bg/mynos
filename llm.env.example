# The language models MyNOS may use (doc/decisions/llm.md).
#
# Copy this file to llm.env (ignored by git) and fill in your keys:
# tools/run-demo.sh copies llm.env into the demo's disk, where llmd reads it
# as /disk/llm.env (again at every request: edits take effect at once).
# Without it MyNOS works the same, with no model: llm and ask say so.
#
# Each profile is a group of LLM_<NAME>_* lines; programs choose one by its
# name in lower case (llm -p local "..."), or get LLM_DEFAULT's.
#
#   LLM_<NAME>_API         anthropic (Claude's Messages API) or openai (Chat
#                          Completions: OpenAI, vLLM, Ollama, llama.cpp,
#                          LM Studio, OpenRouter...)
#   LLM_<NAME>_MODEL       the model's name for that API
#   LLM_<NAME>_KEY         the API key (empty for servers that need none)
#   LLM_<NAME>_URL         the API's base, with /v1 (default: Anthropic's or
#                          OpenAI's)
#   LLM_<NAME>_MAX_TOKENS  the longest answer, in tokens (default 16000)
#   LLM_<NAME>_EFFORT      anthropic: low, medium, high, xhigh or max (how
#                          much the model thinks; default: the model's)
#   LLM_<NAME>_FALLBACKS   anthropic: "default" lets the API answer with
#                          another model when this one declines a request
#
# The syntax is a .env file's: NAME=value, # comments, values in quotes or
# not, ${NAME} for a value set above (so ANTHROPIC_API_KEY=... lines from
# another .env can be reused). MyNOS has no users yet: any program in it
# can read this file. To keep a key out of MyNOS, point URL at a proxy on
# the host that adds it (http://10.0.2.2:PORT/v1) and leave KEY empty.

LLM_DEFAULT=claude

# Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...
LLM_CLAUDE_API=anthropic
LLM_CLAUDE_MODEL=claude-opus-5-5
LLM_CLAUDE_KEY=${ANTHROPIC_API_KEY}
LLM_CLAUDE_EFFORT=medium
LLM_CLAUDE_FALLBACKS=default

# A cheaper, faster Claude, for small tasks
LLM_HAIKU_API=anthropic
LLM_HAIKU_MODEL=claude-haiku-5-5
LLM_HAIKU_KEY=${ANTHROPIC_API_KEY}

# OpenAI (https://platform.openai.com/)
#LLM_GPT_API=openai
#LLM_GPT_MODEL=<a model of yours>
#LLM_GPT_KEY=sk-...

# Ollama on the host (ollama serve; 10.0.2.2 is the host, seen from QEMU)
#LLM_LOCAL_API=openai
#LLM_LOCAL_MODEL=qwen3:8b
#LLM_LOCAL_URL=http://10.0.2.2:11434/v1

# vLLM on the host (vllm serve MODEL)
#LLM_VLLM_API=openai
#LLM_VLLM_MODEL=<the model vllm serves>
#LLM_VLLM_URL=http://10.0.2.2:8000/v1
