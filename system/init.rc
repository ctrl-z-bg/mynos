# MyNOS init configuration (init/init.ml): the programs started at boot,
# from the RAM disk, in order.
#   start PROGRAM ARGS...     start it and leave it running (services)
#   driver PROGRAM ARGS...    the same, with the io privilege: port I/O and
#                             IRQs (doc/decisions/identity-and-permissions.md)
#   respawn PROGRAM ARGS...   start it, and again whenever it ends
# A .byte program runs on ocamlrun.

driver consoled
start tmpfs.byte
start clipboard.byte
driver ata.byte
driver vblkd
start fatfs.byte
driver pagerd.byte
driver netd
driver displayd
driver soundd
start imaged
start llmd.byte
start httpd.byte
start pkg.byte boot
respawn sh.byte
