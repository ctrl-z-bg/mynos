# MyNOS init configuration (init/init.ml): the programs started at boot,
# from the RAM disk, in order.
#   start PROGRAM ARGS...     start it and leave it running (services)
#   driver PROGRAM ARGS...    the same, with the io privilege: port I/O and
#                             IRQs (doc/decisions/identity-and-permissions.md)
#   respawn PROGRAM ARGS...   start it, and again whenever it ends
# A .byte program runs on ocamlrun.

driver consoled
start tmpfs.byte
start clipboard.byte
driver ata.byte
driver vblkd
start fatfs.byte
driver pagerd.byte
driver netd
driver displayd
driver soundd
start llmd.byte
start httpd.byte
start pkg.byte boot
respawn sh.byte
# a Raspberry Pi's SD card (sd0, fatfs's /disk): last, so that the other
# programs keep their pids everywhere (fatfs waits for a disk up to 10 s)
driver sdhcid
# the USB (usbd: keyboards and mice on an xHCI; a Pi 4's or 400's, QEMU's
# qemu-xhci), after consoled's keys service
driver usbd
# a Raspberry Pi 4's or 400's Wi-Fi (wifid: its firmware from /disk/wifi)
driver wifid
