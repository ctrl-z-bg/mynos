# MyNOS dev build environment: a modern toolchain.
#
# Debian 13 "trixie", i386: gcc 14, binutils 2.44, nasm 2.16.
# User-space programs are static Linux i386 binaries built with musl.
# OCaml 5.5.2 (doc/decisions/ocaml-runtime.md):
#   /opt/ocaml-5.5.2            the compiler (bytecode only), to compile programs
#   /opt/ocaml-runtime-musl     the upstream bytecode runtime built with musl
#                               (libcamlrun.a, prims.o), linked into MyNOS's
#                               ocamlrun by mynos-runtime/Makefile
#
# Build:  tools/containers/build-image.sh dev
# Use:    tools/in-container.sh dev <command>

ARG OCAML_VERSION=5.5.2

# --- Stage 1: fetch sources with a modern TLS stack -------------------------
FROM docker.io/library/debian:bookworm-slim AS fetch
ARG OCAML_VERSION
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
RUN curl -fsSLO https://caml.inria.fr/pub/distrib/ocaml-5.5/ocaml-${OCAML_VERSION}.tar.gz \
 && echo "0b2fa96469edb7dd770afba8bcab72808ebb308fe5d3b9379f42d7956523fa86  ocaml-${OCAML_VERSION}.tar.gz" \
    | sha256sum -c -

# --- Stage 2: OCaml compiler and musl runtime --------------------------------
FROM docker.io/library/debian:trixie-slim AS ocaml
ARG OCAML_VERSION
RUN apt-get update \
 && apt-get install -y --no-install-recommends gcc libc6-dev make musl-tools musl-dev \
 && rm -rf /var/lib/apt/lists/*
COPY --from=fetch /src/ocaml-${OCAML_VERSION}.tar.gz /tmp/
# the compiler, for the build host (glibc), bytecode only
RUN mkdir /tmp/host && cd /tmp/host \
 && tar xzf /tmp/ocaml-${OCAML_VERSION}.tar.gz --strip-components=1 \
 && ./configure --prefix=/opt/ocaml-${OCAML_VERSION} --disable-native-compiler \
      --disable-ocamldoc --disable-ocamltest \
 && make -j4 && make install
# the bytecode runtime for MyNOS: static, musl
RUN mkdir /tmp/musl && cd /tmp/musl \
 && tar xzf /tmp/ocaml-${OCAML_VERSION}.tar.gz --strip-components=1 \
 && ./configure --build=i686-pc-linux-gnu --host=i686-pc-linux-gnu \
      CC=musl-gcc LDFLAGS=-static --disable-shared --disable-native-compiler \
      --disable-ocamldoc --disable-ocamltest --disable-debug-runtime \
      --disable-instrumented-runtime \
 && make -j4 runtime/ocamlrun \
 && mkdir -p /opt/ocaml-runtime-musl \
 && cp runtime/libcamlrun.a runtime/prims.o /opt/ocaml-runtime-musl/ \
 && echo "${OCAML_VERSION}" > /opt/ocaml-runtime-musl/VERSION

# --- Stage 3: the toolchain --------------------------------------------------
FROM docker.io/library/debian:trixie-slim
ARG OCAML_VERSION
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      gcc libc6-dev make binutils nasm musl-tools musl-dev \
 && rm -rf /var/lib/apt/lists/*
COPY --from=ocaml /opt/ocaml-${OCAML_VERSION} /opt/ocaml-${OCAML_VERSION}
COPY --from=ocaml /opt/ocaml-runtime-musl /opt/ocaml-runtime-musl
ENV PATH=/opt/ocaml-${OCAML_VERSION}/bin:$PATH
# Read by the user-space Makefiles (see mynos.mk) and tools/build-all.sh.
# -Ttext-segment moves the whole image (musl's crti has an .init section
# that -Ttext would leave at the default address); the kernel loads the
# segments as one contiguous image and jumps to the ELF entry point.
ENV MYNOS_CC=musl-gcc \
    MYNOS_LDFLAGS="-static -Wl,-Ttext-segment=0x40000000 -Wl,-z,noseparate-code -Wl,--build-id=none" \
    MYNOS_RUNTIME=mynos-runtime \
    OCAML_RUNTIME_LIB=/opt/ocaml-runtime-musl
WORKDIR /mynos
