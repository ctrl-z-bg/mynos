# MyNOS legacy build environment: the toolchain of the original project.
#
# The last original commits (November 2008) add -fno-stack-protector, which
# needs gcc >= 4.1: they were built with gcc 4.3 (Ubuntu 8.10 era). So the
# toolchain is Debian 5.0 "lenny", i386: gcc 4.3.2, binutils 2.18, nasm 2.03,
# dietlibc 0.31.
#
# OCaml 3.06, the version mynos-byterun is based on, is built from source on
# Debian 3.1 "sarge" (gcc 3.3, closer to its own era) and copied over. It is
# used to compile bytecode the MyNOS runtime can execute.
#
# Build:  tools/containers/build-image.sh legacy
# Use:    tools/in-container.sh legacy <command>

# --- Stage 1: fetch sources with a modern TLS stack -------------------------
FROM docker.io/library/debian:bookworm-slim AS fetch
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
RUN curl -fsSLO https://caml.inria.fr/pub/distrib/ocaml-3.06/ocaml-3.06.tar.gz \
 && echo "1509bde867515d7e7b51710f2b0d2efe0ab5e5918d475244882e615d970b729a  ocaml-3.06.tar.gz" \
    | sha256sum -c -

# --- Stage 2: OCaml 3.06 on sarge (2005) -------------------------------------
FROM docker.io/debian/eol:sarge AS ocaml
RUN apt-get update \
 && apt-get install -y gcc libc6-dev make \
 && apt-get clean
COPY --from=fetch /src/ocaml-3.06.tar.gz /tmp/
# Bytecode only. The kernel reports x86_64, so force the host type.
RUN cd /tmp \
 && tar xzf ocaml-3.06.tar.gz \
 && cd ocaml-3.06 \
 && ./configure -prefix /opt/ocaml-3.06 -host i386-pc-linux-gnu -no-tk \
 && make world \
 && make install

# --- Stage 3: the 2008 toolchain on lenny ------------------------------------
FROM docker.io/debian/eol:lenny
RUN apt-get update \
 && apt-get install -y gcc libc6-dev make binutils nasm dietlibc-dev \
 && apt-get clean
COPY --from=ocaml /opt/ocaml-3.06 /opt/ocaml-3.06
ENV PATH=/opt/ocaml-3.06/bin:$PATH
WORKDIR /mynos
