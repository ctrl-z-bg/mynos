+	/* (MyNOS) all the text selected: typing replaces it, deleting
+	 * clears it, moving the caret unselects it; Ctrl-A selects all */
+	if ((modifier & (FBTK_MOD_LCTRL | FBTK_MOD_RCTRL)) && value == NSFB_KEY_a) {
+		widget->u.text.selected = true;
+		widget->u.text.idx = widget->u.text.len;
+		caret_moved = true;
+		value = -1;
+	} else if (widget->u.text.selected) {
+		switch (value) {
+		case NSFB_KEY_RSHIFT: case NSFB_KEY_LSHIFT:
+		case NSFB_KEY_RCTRL: case NSFB_KEY_LCTRL:
+		case NSFB_KEY_RETURN:
+			break;
+		case NSFB_KEY_BACKSPACE:
+		case NSFB_KEY_DELETE:
+			widget->u.text.selected = false;
+			widget->u.text.idx = widget->u.text.len = 0;
+			widget->u.text.text[0] = '\0';
+			widget->u.text.width = 0;
+			caret_moved = true;
+			value = -1;
+			break;
+		case NSFB_KEY_LEFT: case NSFB_KEY_RIGHT:
+		case NSFB_KEY_HOME: case NSFB_KEY_END:
+		case NSFB_KEY_UP: case NSFB_KEY_DOWN:
+		case NSFB_KEY_PAGEUP: case NSFB_KEY_PAGEDOWN:
+			widget->u.text.selected = false;
+			break;
+		default:
+			widget->u.text.selected = false;
+			if (!(modifier & (FBTK_MOD_LCTRL | FBTK_MOD_RCTRL))) {
+				/* a character: the text goes, it comes */
+				widget->u.text.idx = widget->u.text.len = 0;
+				widget->u.text.text[0] = '\0';
+				widget->u.text.width = 0;
+			}
+			break;
+		}
+	}
+
 	switch (value) {
+	case -1:
+		break;
+
+	case NSFB_KEY_DELETE:
+		/* (MyNOS) the character after the caret */
+		if (widget->u.text.idx >= widget->u.text.len)
+			break;
+		memmove(widget->u.text.text + widget->u.text.idx,
+				widget->u.text.text + widget->u.text.idx + 1,
+				widget->u.text.len - widget->u.text.idx);
+		widget->u.text.len--;
+		fb_font_width(&font_style, widget->u.text.text,
+				widget->u.text.len, &widget->u.text.width);
+		caret_moved = true;
+		break;
+
 	case NSFB_KEY_BACKSPACE:
 		if (widget->u.text.idx <= 0)
 			break;
