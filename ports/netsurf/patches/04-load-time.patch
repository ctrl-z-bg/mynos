@@ -2061,6 +2063,13 @@
 static void
 gui_window_stop_throbber(struct gui_window *gw)
 {
+	/* (MyNOS experiment) NSFB_TIME: the time the page took, to stderr */
+	if (getenv("NSFB_TIME") != NULL) {
+		struct timespec t;
+		clock_gettime(CLOCK_MONOTONIC, &t);
+		fprintf(stderr, "nsfb-time: loaded at %.3f s\n",
+			t.tv_sec + t.tv_nsec / 1e9 - nsfb_time_start);
+	}
 	gw->throbber_index = -1;
 	fbtk_set_bitmap(gw->throbber, &throbber0);
 
