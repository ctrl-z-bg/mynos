--- a/libnsfb/src/surface/ram.c
+++ b/libnsfb/src/surface/ram.c
@@ -111,11 +111,36 @@
     return 0;
 }
 
+#include <time.h>
+#include <unistd.h>
+
+/* (MyNOS experiment, mynos-6e0) NSFB_DUMP=FILE: after NSFB_DUMP_AT seconds
+   (5), the surface written to FILE as a PPM, then NetSurf asked to quit */
 static bool ram_input(nsfb_t *nsfb, nsfb_event_t *event, int timeout)
 {
-    UNUSED(nsfb);
-    UNUSED(event);
-    UNUSED(timeout);
+    static time_t start = 0;
+    static int done = 0;
+    const char *dump = getenv("NSFB_DUMP");
+    const char *at = getenv("NSFB_DUMP_AT");
+    if (start == 0) start = time(NULL);
+    if (timeout > 0 && getenv("NSFB_NOSLEEP") == NULL) usleep(timeout * 1000 > 100000 ? 100000 : timeout * 1000);
+    if (dump != NULL && !done && time(NULL) - start >= (at ? atoi(at) : 5)) {
+        FILE *f = fopen(dump, "wb");
+        int x, y;
+        done = 1;
+        if (f != NULL) {
+            fprintf(f, "P6\n%d %d\n255\n", nsfb->width, nsfb->height);
+            for (y = 0; y < nsfb->height; y++)
+                for (x = 0; x < nsfb->width; x++) {
+                    uint8_t *p = nsfb->ptr + y * nsfb->linelen + x * 4;
+                    fputc(p[2], f); fputc(p[1], f); fputc(p[0], f);
+                }
+            fclose(f);
+        }
+        event->type = NSFB_EVENT_CONTROL;
+        event->value.controlcode = NSFB_CONTROL_QUIT;
+        return true;
+    }
     return false;
 }
 
